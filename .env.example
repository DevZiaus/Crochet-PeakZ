# ─── Backend (apps/api/.env) ───────────────────────────────────────────────────

# Database
# Any PostgreSQL 18 instance works: local, Docker, or a managed provider.
# Prisma migrations use this same URL. If your provider offers pooled and
# direct URLs, use the direct/session URL for this always-on API.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/crochet_peakz_dev

# JWT
JWT_SECRET=...
JWT_REFRESH_SECRET=...

# Auth
# Public web origin used in email links, OAuth callbacks, and redirects.
WEB_APP_URL=http://localhost:3000
# Shared secret the Next.js proxy sends on every auth request. Must match
# PROXY_SHARED_SECRET in apps/web/.env.local.
PROXY_SHARED_SECRET=...
# Verified Resend sender for verification and reset email.
EMAIL_FROM=Crochet PeakZ <onboarding@resend.dev>

# OAuth 2.0
GOOGLE_CLIENT_ID=...
GOOGLE_CLIENT_SECRET=...
FACEBOOK_APP_ID=...
FACEBOOK_APP_SECRET=...

# Cloudinary
CLOUDINARY_CLOUD_NAME=...
CLOUDINARY_API_KEY=...
CLOUDINARY_API_SECRET=...

# Email
RESEND_API_KEY=...

# Payments
STRIPE_SECRET_KEY=...
STRIPE_WEBHOOK_SECRET=...
PAYPAL_CLIENT_ID=...
PAYPAL_CLIENT_SECRET=...
SSLCOMMERZ_STORE_ID=...
SSLCOMMERZ_STORE_PASSWORD=...

# Monitoring
SENTRY_DSN=...

# Server
# Comma separated browser origins allowed to send credentials. Wildcards are
# rejected. Not needed when web and API share an origin through a proxy, but
# harmless to set to the public web origin.
CORS_ORIGIN=http://localhost:3000
NODE_ENV=development
HOST=0.0.0.0
PORT=4000
# Set to 1 behind one reverse proxy (Nginx, Caddy, a managed load balancer).
TRUST_PROXY=false

# ─── Frontend (apps/web/.env.local) ───────────────────────────────────────────

# NEXT_PUBLIC_* values are inlined at build time. Use /api when a reverse proxy
# serves web and API on the same origin, or an absolute API URL otherwise.
NEXT_PUBLIC_API_URL=http://localhost:4000/api
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=...
NEXT_PUBLIC_PAYPAL_CLIENT_ID=...
NEXT_PUBLIC_GA_MEASUREMENT_ID=...
NEXT_PUBLIC_META_PIXEL_ID=...
NEXT_PUBLIC_SENTRY_DSN=...

# Auth proxy (server only). Must match the API values above.
API_INTERNAL_URL=http://localhost:4000/api
PROXY_SHARED_SECRET=...
WEB_APP_URL=http://localhost:3000
