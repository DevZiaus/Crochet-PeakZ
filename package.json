{
  "name": "crochet-peakz",
  "version": "0.0.0",
  "private": true,
  "description": "Crochet PeakZ — handmade crochet e-commerce platform",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently --names api,web --prefix-colors blue,magenta \"npm run dev --workspace=apps/api\" \"npm run dev --workspace=apps/web\"",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "concurrently": "^9.1.2",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.9",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=24.20.0"
  },
  "lint-staged": {
    "apps/web/**/*.{ts,tsx,mts,js,mjs}": [
      "eslint --config apps/web/eslint.config.mjs --fix",
      "prettier --write"
    ],
    "apps/api/**/*.{ts,tsx,mts,js,mjs}": [
      "eslint --config apps/api/eslint.config.mjs --fix",
      "prettier --write"
    ],
    "packages/**/*.{ts,tsx,mts,js,mjs}": [
      "eslint --config eslint.config.mjs --fix",
      "prettier --write"
    ],
    "./*.{ts,tsx,mts,js,mjs}": [
      "eslint --config eslint.config.mjs --fix",
      "prettier --write"
    ],
    "*.{json,md,css,html,yml,yaml}": [
      "prettier --write"
    ]
  }
}
