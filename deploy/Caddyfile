# Optional same-origin reverse proxy for the Docker Compose stack.
#
#   DOMAIN=shop.example.com docker compose --profile proxy up -d --build
#
# Build the web image with NEXT_PUBLIC_API_URL=/api so the browser calls the
# API through this proxy. Caddy obtains a TLS certificate automatically when
# DOMAIN is a public hostname; localhost is served over plain HTTP.
#
# Running behind Cloudflare CDN on a VPS:
# 1. Firewall ports 80/443 so only Cloudflare IPs (or Cloudflare Tunnel) reach Caddy.
# 2. Option A (recommended, keep TRUST_PROXY=1 and TRUSTED_PROXY_HOPS=1): add a global
#    `servers { trusted_proxies static <cloudflare-cidrs> }` + `client_ip_headers CF-Connecting-IP`
#    block above `{$DOMAIN:localhost}` so Caddy forwards the real visitor IP as 1 hop.
# 3. Option B (without real_ip): configure `trusted_proxies static <cloudflare-cidrs>`
#    and set `TRUST_PROXY=2` and `TRUSTED_PROXY_HOPS=2` so the apps read 2 hops back.
{$DOMAIN:localhost} {
	encode zstd gzip

	# Auth calls must reach the Next.js proxy so it can add the shared secret,
	# relay cookies, and refresh an expired access token once. Caddy sorts
	# handle blocks by path specificity, so this wins over /api/*.
	handle /api/auth/* {
		# Auth bodies are small JSON payloads. Cap them here as well so a large
		# upload is rejected before it reaches the Next.js proxy.
		request_body {
			max_size 1MB
		}
		reverse_proxy web:3000
	}

	# Contact payloads are small JSON bodies; enforce the 20KB cap at the edge
	# to match the Next.js contact proxy limit.
	handle /api/contact {
		request_body {
			max_size 20KB
		}
		reverse_proxy api:4000
	}

	handle /api/* {
		reverse_proxy api:4000
	}

	handle {
		reverse_proxy web:3000
	}
}
