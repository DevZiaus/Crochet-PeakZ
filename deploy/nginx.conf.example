# Example Nginx reverse proxy for a self-hosted deployment.
#
# The API and web server listen on localhost ports (or container names on a
# Docker network). Route /api/auth/* to Next.js so its auth proxy can add the
# shared secret and relay cookies, route other /api/* to Express, and route
# everything else to Next.js. The browser still sees one origin, which keeps
# cookies first-party and avoids CORS.
#
# If you use this file, build the web image with NEXT_PUBLIC_API_URL=/api.
# Set TRUST_PROXY=1 on the API so Express reads X-Forwarded-* correctly.
#
# Running behind Cloudflare CDN on a VPS:
# 1. Firewall ports 80/443 so only Cloudflare IPs (or Cloudflare Tunnel) reach Nginx.
# 2. Recommended (keep TRUST_PROXY=1 and TRUSTED_PROXY_HOPS=1): enable ngx_http_realip_module
#    with `set_real_ip_from <cloudflare-cidrs>;` and `real_ip_header CF-Connecting-IP;`
#    so `$remote_addr` becomes the real visitor IP on every `location` block below.
# 3. Alternative without realip: switch `X-Forwarded-For` on `location = /api/contact`
#    and `location /api/` back to `$proxy_add_x_forwarded_for` and set `TRUST_PROXY=2`
#    and `TRUSTED_PROXY_HOPS=2`.

server {
    listen 80;
    server_name shop.example.com;

    client_max_body_size 12m;

    # Auth calls go to the Next.js proxy, which adds the shared secret, relays
    # cookies, and refreshes an expired access token once. Other API calls go
    # straight to Express.
    location /api/auth/ {
        client_max_body_size 1m;
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
    }

    # Cap contact submissions at 20k (matching CONTACT_MAX_BODY_BYTES) before
    # oversized payloads reach Express.
    location = /api/contact {
        client_max_body_size 20k;
        proxy_pass http://127.0.0.1:4000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        # Nginx is the sole trusted edge, so overwrite X-Forwarded-For with
        # $remote_addr to keep /api/contact rate limits unspoofable.
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
    }

    location /api/ {
        proxy_pass http://127.0.0.1:4000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        # Nginx is the sole trusted edge, so overwrite X-Forwarded-For with
        # $remote_addr to keep direct API rate limits (like /api/contact) unspoofable.
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
    }

    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
    }
}
