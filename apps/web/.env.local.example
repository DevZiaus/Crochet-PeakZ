# API connection
# NEXT_PUBLIC_* values are inlined at build time, not read at runtime.
# - separate web/API origins: http://localhost:4000/api
# - same origin through a reverse proxy: /api
NEXT_PUBLIC_API_URL=http://localhost:4000/api

# Auth proxy (server only, never NEXT_PUBLIC_*)
# The Next.js server calls the API through API_INTERNAL_URL and stamps every
# request with PROXY_SHARED_SECRET, which must match apps/api.
API_INTERNAL_URL=http://localhost:4000/api
PROXY_SHARED_SECRET=replace-with-the-same-value-as-apps-api
# Public origin of this web app. The proxy uses it for the Origin check.
WEB_APP_URL=http://localhost:3000

# Payments (client-side keys)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=...
NEXT_PUBLIC_PAYPAL_CLIENT_ID=...

# Analytics
NEXT_PUBLIC_GA_MEASUREMENT_ID=...
NEXT_PUBLIC_META_PIXEL_ID=...

# Monitoring
NEXT_PUBLIC_SENTRY_DSN=...
