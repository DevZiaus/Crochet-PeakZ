# Database
# Any PostgreSQL 18 instance works: local, Docker, or a managed provider.
# Prisma migrations use this same URL. If your provider offers pooled and
# direct URLs, use the direct/session URL for this always-on API.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/crochet_peakz_dev

# JWT
# Both secrets are required, at least 32 characters, and must differ.
# JWT_SECRET signs access tokens and the OAuth state value.
# JWT_REFRESH_SECRET keys the digest stored for refresh tokens.
JWT_SECRET=change-me-in-production
JWT_REFRESH_SECRET=change-me-in-production-too

# Auth
# Public web origin used in verification and reset links, OAuth callbacks,
# and redirects. No trailing slash.
WEB_APP_URL=http://localhost:3000
# Shared secret the Next.js proxy sends on every auth request. At least 16
# characters. Must match PROXY_SHARED_SECRET in apps/web/.env.local.
PROXY_SHARED_SECRET=change-me-proxy-secret
# Verified Resend sender for verification and password reset email.
EMAIL_FROM=Crochet PeakZ <onboarding@resend.dev>

# OAuth 2.0
# Register these redirect URIs on the provider apps:
#   http://localhost:3000/api/auth/google/callback
#   http://localhost:3000/api/auth/facebook/callback
GOOGLE_CLIENT_ID=...
GOOGLE_CLIENT_SECRET=...
FACEBOOK_APP_ID=...
FACEBOOK_APP_SECRET=...
# Test-only endpoint overrides for a local mock provider. Any value here makes
# the API refuse to start when NODE_ENV=production. Leave them unset to use the
# real Google and Facebook endpoints.
# GOOGLE_AUTH_URL=http://127.0.0.1:9099/oauth/google/authorize
# GOOGLE_TOKEN_URL=http://127.0.0.1:9099/oauth/google/token
# GOOGLE_USERINFO_URL=http://127.0.0.1:9099/oauth/google/userinfo
# FACEBOOK_AUTH_URL=http://127.0.0.1:9099/oauth/facebook/authorize
# FACEBOOK_TOKEN_URL=http://127.0.0.1:9099/oauth/facebook/token
# FACEBOOK_PROFILE_URL=http://127.0.0.1:9099/oauth/facebook/profile

# Cloudinary
CLOUDINARY_CLOUD_NAME=...
CLOUDINARY_API_KEY=...
CLOUDINARY_API_SECRET=...

# Email
RESEND_API_KEY=...
# Optional destination inbox for contact form submissions (defaults to hello@crochetpeakz.tech)
# CONTACT_EMAIL=hello@crochetpeakz.tech

# Payments
STRIPE_SECRET_KEY=...
STRIPE_WEBHOOK_SECRET=...
PAYPAL_CLIENT_ID=...
PAYPAL_CLIENT_SECRET=...
SSLCOMMERZ_STORE_ID=...
SSLCOMMERZ_STORE_PASSWORD=...

# Monitoring
SENTRY_DSN=...

# Server
# Comma separated browser origins allowed to send credentials. Wildcards are
# rejected. Not needed when web and API share an origin through a proxy.
CORS_ORIGIN=http://localhost:3000
NODE_ENV=development
HOST=0.0.0.0
PORT=4000
# Set to 1 behind one reverse proxy (Nginx, Caddy, a managed load balancer).
TRUST_PROXY=false
