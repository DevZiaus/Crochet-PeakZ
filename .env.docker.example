# Environment for `docker compose` (copy to .env in the repository root).
#
# These are substitution values for docker-compose.yml. Application secrets
# (JWT, OAuth, Cloudinary, payments, email) are added to the api service's
# environment as those features are built. Never commit the real .env.

# PostgreSQL
POSTGRES_USER=crochet
POSTGRES_PASSWORD=change-me
POSTGRES_DB=crochet_peakz

# Published ports
WEB_PORT=3000
API_PORT=4000
HTTP_PORT=80
HTTPS_PORT=443

# Browser-facing API URL. Next.js inlines this at build time:
# - direct containers: http://localhost:4000/api
# - same-origin proxy:  /api
# Rebuild the web image after changing it.
NEXT_PUBLIC_API_URL=http://localhost:4000/api

# Browser origin allowed to call the API with credentials. Comma separate
# multiple origins. Wildcards are rejected because cookies are enabled.
CORS_ORIGIN=http://localhost:3000

# Reverse proxy setting. Use 1 behind one Nginx/Caddy hop, or false when the
# API is reached directly.
TRUST_PROXY=false

# Apply Prisma migrations on API start. Keep true for one self-hosted
# instance; set false and run migrations as a release job with replicas.
RUN_MIGRATIONS=true

# ─── Customer auth ────────────────────────────────────────────────────────────
# All of these are required. The API refuses to start with a missing value, a
# short secret, or a placeholder. Generate the secrets with:
#   openssl rand -hex 32
# JWT_SECRET and JWT_REFRESH_SECRET must be different.
JWT_SECRET=change-me-e2a7c4d1f0b9a8e7d6c5b4a39281706f
JWT_REFRESH_SECRET=change-me-1f2e3d4c5b6a79880716253443526170
# Shared between the api and web services on every auth request.
PROXY_SHARED_SECRET=change-me-9a8b7c6d5e4f30211203f4e5d6c7b8a9
# Public web origin used in email links, OAuth callbacks, and redirects.
WEB_APP_URL=http://localhost:3000
# The web container reaches the API over the compose network. Override this
# only when the API runs outside this compose project.
API_INTERNAL_URL=http://api:4000/api
# Verified Resend sender for verification and password reset email.
RESEND_API_KEY=...
EMAIL_FROM=Crochet PeakZ <onboarding@resend.dev>
# OAuth 2.0 applications. Callback URLs point at the public web origin:
#   <WEB_APP_URL>/api/auth/google/callback
#   <WEB_APP_URL>/api/auth/facebook/callback
GOOGLE_CLIENT_ID=...
GOOGLE_CLIENT_SECRET=...
FACEBOOK_APP_ID=...
FACEBOOK_APP_SECRET=...

# Public hostname for the optional Caddy profile (automatic HTTPS).
DOMAIN=localhost
